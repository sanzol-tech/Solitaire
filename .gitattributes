# The repository always stores LF; eol= decides what the working tree gets.
*               text=auto

*.java          text eol=lf
*.xml           text eol=lf
*.gradle        text eol=lf
*.properties    text eol=lf
*.pro           text eol=lf
*.md            text eol=lf
gradlew         text eol=lf

# Windows scripts: CRLF required.
*.bat           text eol=crlf
*.cmd           text eol=crlf
*.ps1           text eol=crlf

*.png           binary
*.jar           binary
*.wav           binary
*.jks           binary
